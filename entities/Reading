{
  "name": "Reading",
  "type": "object",
  "properties": {
    "hexagram_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "hexagram_name": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Six line values (6,7,8,9) bottom to top"
    },
    "changing_lines": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "relating_hexagram": {
      "type": "integer"
    },
    "question": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "auto",
        "yarrow",
        "coin"
      ]
    },
    "reading_mode": {
      "type": "string",
      "enum": [
        "inquirer",
        "adept",
        "seeker",
        "guided",
        "deep"
      ],
      "description": "Chosen reading role. Seeker, guided, and deep are retained for legacy readings."
    },
    "mood_tag": {
      "type": "string",
      "enum": [
        "clarity",
        "uncertainty",
        "transition",
        "stillness",
        "growth",
        "release"
      ]
    },
    "sphere_focus": {
      "type": "string",
      "enum": [
        "social",
        "martial",
        "qi",
        "tao"
      ]
    },
    "practice_intention": {
      "type": "string"
    },
    "follow_up_at": {
      "type": "string",
      "format": "date"
    },
    "outcome_notes": {
      "type": "string"
    },
    "revisit_status": {
      "type": "string",
      "enum": [
        "open",
        "integrated"
      ]
    },
    "content_version": {
      "type": "string"
    },
    "algorithm_version": {
      "type": "string"
    }
  },
  "required": [
    "hexagram_number",
    "hexagram_name",
    "method",
    "lines"
  ]
}
