# -----------------------------------------------------------------------------
# Environment variables (Vite) — copy to `.env.local` and fill in as needed.
# All vars must be prefixed with VITE_ to be exposed to the client bundle.
# -----------------------------------------------------------------------------

# --- Google AdSense (optional) -----------------------------------------------
# Publisher / client ID from AdSense ("ca-pub-XXXXXXXXXXXXXXXX").
# When unset, AdSlot components render nothing (prod) or a dev placeholder.
VITE_GOOGLE_ADS_CLIENT_ID=

# Per-placement ad unit slot IDs. The placement prop on <AdSlot placement="…" />
# is uppercased and hyphens/non-alphanumerics are replaced with underscores
# to produce the variable name — e.g.:
#   <AdSlot placement="reading-footer" />  → VITE_GOOGLE_ADS_SLOT_READING_FOOTER
#   <AdSlot placement="site-footer"     /> → VITE_GOOGLE_ADS_SLOT_SITE_FOOTER
VITE_GOOGLE_ADS_SLOT_SITE_FOOTER=
VITE_GOOGLE_ADS_SLOT_READING_FOOTER=
