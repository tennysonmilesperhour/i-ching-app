    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^15.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.0",
    "vite": "8.3.6"
  },
