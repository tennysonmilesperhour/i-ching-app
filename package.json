{
  "name": "i-ching-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/build-agent-files.mjs",
    "native:build": "VITE_NATIVE_BUILD=1 SKIP_AGENT_FILES=1 npm run build && node scripts/check-native-bundle.mjs",
    "native:sync": "npm run native:build && cap sync ios",
    "native:open": "cap open ios",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "node --test src/lib/*.test.js",
    "gen:vercel": "node scripts/gen-vercel-config.mjs",
    "agent:review": "node scripts/agent-review.mjs",
    "capacitor:copy:before": "node scripts/check-native-bundle.mjs"
  },
  "dependencies": {
